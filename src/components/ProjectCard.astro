---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="la-card portfolio-project-card">
  <!-- project image -->
{project.image && (
  <div class="portfolio-project-image-frame">
    <img
      class="portfolio-project-image"
      src={project.image.src}
      alt={project.image.alt}
      width={project.image.width}
      height={project.image.height}
      loading="lazy"
      decoding="async"
    />
  </div>
)}
  <!-- project content -->
<div class="portfolio-project-body">
    <!-- project title -->
    <h3 class="la-m-0">{project.title}</h3>
    <!-- project description -->
    <p class="portfolio-project-description">{project.description}</p>
    <!-- project links -->
<div class="la-button-row portfolio-project-actions">
      <a class="la-btn la-btn-secondary la-btn-sm" href={project.repoUrl} aria-label={`${project.title} on GitHub`}>GitHub</a>
      {project.liveUrl && <a class="la-btn la-btn-secondary la-btn-sm" href={project.liveUrl} aria-label={`Open ${project.title}`}>Live</a>}
      {project.downloadUrl && <a class="la-btn la-btn-secondary la-btn-sm" href={project.downloadUrl} aria-label={`${project.title} ${project.downloadLabel ?? 'Download'}`}>{project.downloadLabel ?? 'Download'}</a>}
    </div>
  </div>
</article>
