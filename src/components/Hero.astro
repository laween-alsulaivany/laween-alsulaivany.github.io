---
import { profile } from '../data/profile';
---

<section id="home" class="portfolio-hero" aria-labelledby="home-title">
  <div class="portfolio-hero-copy">
    <p class="portfolio-hero-eyebrow la-m-0">
      Hello visitor, my name is
    </p>

    <h1 id="home-title" class="portfolio-hero-title">
      <span>Laween</span>
      Al-Sulaivany
    </h1>

    <p class="portfolio-hero-description">
      I like figuring out how things work, finding what could be better, and making it better.
    </p>

    <div class="portfolio-hero-actions">
      <a class="la-btn la-btn-primary" href={profile.github}>
        GitHub
      </a>

    </div>
  </div>

  <div class="portfolio-hero-blueprint" aria-hidden="true">
    <svg
      viewBox="0 0 440 360"
      fill="none"
      focusable="false"
    >
      <!-- construction grid -->
<g class="portfolio-blueprint-grid">
  <!-- outer construction frame -->
  <rect x="70" y="58" width="270" height="264" />

  <!-- vertical construction lines -->
  <path d="M92 42V338" />
  <path d="M146 74V322" />
  <path d="M200 42V338" />
  <path d="M254 74V322" />
  <path d="M308 42V338" />

  <!-- horizontal construction lines -->
  <path d="M54 90H356" />
  <path d="M72 144H332" />
  <path d="M46 198H364" />
  <path d="M72 252H332" />
  <path d="M54 306H356" />

  <!-- secondary dashed guides -->
  <path class="portfolio-blueprint-dashed" d="M110 72V324" />
  <path class="portfolio-blueprint-dashed" d="M174 72V324" />
  <path class="portfolio-blueprint-dashed" d="M282 72V324" />

  <path class="portfolio-blueprint-dashed" d="M68 118H338" />
  <path class="portfolio-blueprint-dashed" d="M68 226H338" />
  <path class="portfolio-blueprint-dashed" d="M68 280H338" />
</g>

<g class="portfolio-blueprint-marks">
  <!-- top-left construction cross -->
  <path d="M58 58h24M70 46v24" />

  <!-- lower-right construction cross -->
  <path d="M328 318h24M340 306v24" />

  <!-- small drafting ticks -->
  <path d="M92 82v16M84 90h16" />
  <path d="M308 298v16M300 306h16" />

  <!-- offset guide extensions -->
  <path d="M70 58L52 40" />
  <path d="M340 322L358 340" />

  <!-- partial diagonals -->
  <path d="M70 322L112 280" />
  <path d="M340 58L306 92" />
</g>

      <!-- main blueprint outline -->
      <g class="portfolio-blueprint-shape">
        <rect x="96" y="100" width="66" height="150" rx="8" />
        <rect x="178" y="100" width="128" height="72" rx="8" />
        <rect x="178" y="188" width="128" height="62" rx="8" />

        <path d="M96 266H306V310H96Z" />

        <!-- small arch / cutout -->
        <path d="M226 250V224C226 210 234 202 246 202C258 202 266 210 266 224V250" />
      </g>

      <!-- center guides -->
<g class="portfolio-blueprint-guides">
  <path d="M201 38V340" />
  <path d="M42 198H366" />
  <path class="portfolio-blueprint-dashed" d="M246 66V328" />
</g>

      <!-- top dimension -->
      <g class="portfolio-blueprint-dimension">
        <path d="M78 44H324" />
        <path d="M78 36V52" />
        <path d="M324 36V52" />

        <text x="201" y="34" text-anchor="middle">
          320
        </text>
      </g>

      <!-- right dimension -->
      <g class="portfolio-blueprint-dimension">
        <path d="M350 70V310" />
        <path d="M342 70H358" />
        <path d="M342 310H358" />

        <text
          x="371"
          y="190"
          text-anchor="middle"
          transform="rotate(90 371 190)"
        >
          280
        </text>
      </g>

      <!-- lower construction extension -->
      <g class="portfolio-blueprint-extension">
        <path d="M96 310L66 338" />
        <path d="M306 310H348" />
        <path d="M66 338H348" />
      </g>
    </svg>
  </div>
</section>
